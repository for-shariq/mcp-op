{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "mcp-op test rig",
    "websiteUrl": "https://localhost:7071",
    "privacyUrl": "https://localhost:7071/privacy",
    "termsOfUseUrl": "https://localhost:7071/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "MCP OAuth Test",
    "full": "MCP OAuth Test Agent"
  },
  "description": {
    "short": "Tests OAuth 2.0 against a remote MCP server.",
    "full": "A test declarative agent that calls a remote MCP server protected with OAuth 2.0, used to verify the Microsoft 365 Copilot plugin authentication flow end to end."
  },
  "accentColor": "#0078D4",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "mcpOAuthTestAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
