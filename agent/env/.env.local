# Agents Toolkit environment. Values marked "filled by provisioning" are written back by the
# actions in m365agents.yml; leave them empty on first run.
TEAMSFX_ENV=local

# Filled by teamsApp/create.
TEAMS_APP_ID=

# Filled by oauth/register. This becomes the runtime auth reference_id in ai-plugin.json.
MCP_OAUTH_AUTH_CONFIG_ID=

# The MCP server's public base URL, WITHOUT a trailing slash and WITHOUT /mcp.
# The manifest appends /mcp itself. Update this every time the dev tunnel changes.
MCP_SERVER_URL=https://REPLACE-ME-7071.euw.devtunnels.ms

# Static client seeded in src/AuthServer ClientStore. For the DCR path, leave both blank and
# select "OAuth (with dynamic registration)" in Agents Toolkit instead.
OAUTH_CLIENT_ID=copilot-test-client
