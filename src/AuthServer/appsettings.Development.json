{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OAuth": {
    "PublicUrl": "http://localhost:7029",
    "DefaultResource": "http://localhost:7071/mcp",
