    },
    "ExtraClients": [
      {
        "ClientId": "cowork-plugin-client",
        "ClientSecret": "CHANGE-ME-cowork-secret",
        "ClientName": "Microsoft 365 Copilot Cowork plugin",
        "RedirectUris": [
          "https://teams.microsoft.com/api/platform/v1.0/oAuthRedirect",
          "http://localhost:8090/callback"
        ]
      }
    ]
  }
